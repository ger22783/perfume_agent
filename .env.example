# LLM 仅用于意图解析（可选）与解释文案增强（可选开关）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=deepseek-v4-flash

# 配方比例由约束优化求解器决定，不依赖 LLM。
# 解释文案默认使用确定性模板；设为 true 时尝试用 LLM 润色（失败自动回退模板）
EXPLAIN_LLM=false

# 记录存储：Neon Postgres（有值则优先数据库，否则写本地 runtime/records/*.jsonl）
DATABASE_URL=
POSTGRES_URL=

# 本机 Python Hardware Bridge；留空时只模拟百分比→克数换算，不连接 STM32。
HARDWARE_API_URL=http://127.0.0.1:8765/v1/jobs
# 可选：与 Bridge 的 HARDWARE_API_TOKEN 保持一致。
HARDWARE_API_TOKEN=
