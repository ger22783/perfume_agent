# LLM 仅用于意图解析（可选）与解释文案增强（可选开关）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=deepseek-v4-flash

# 配方比例由约束优化求解器决定，不依赖 LLM。
# 解释文案默认使用确定性模板；设为 true 时尝试用 LLM 润色（失败自动回退模板）
EXPLAIN_LLM=false

# 记录存储：Neon Postgres（有值则优先数据库，否则写本地 runtime/records/*.jsonl）
DATABASE_URL=
POSTGRES_URL=

# 香氛硬件网关地址（可选）：配置后「确定」会把配方 POST 到该地址；
# 未配置时前端显示"演示模式，未连接硬件"（模拟发送）
HARDWARE_API_URL=
